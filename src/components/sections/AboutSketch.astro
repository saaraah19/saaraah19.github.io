---
// Astro's little building ritual. The original hand-drawn panorama is kept as a
// single image asset so the linework, lettering, and character stay consistent.
// The lettering baked into the PNG is English in both languages; the alt text and captions are translated.
import { langOf, useT } from '../../i18n';
const S = useT(langOf(Astro)).sketch;
---
<figure class="sk" aria-labelledby="sk-cap" data-stage="1" data-steps={JSON.stringify(S.steps)} data-add={S.add} data-again={S.again}>
  <div class="sketch-window">
    <img
      id="sk-art"
      class="sketch-art"
      src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/astro-building-sketch.png`}
      alt={S.alt}
      width="1833"
      height="858"
      loading="lazy"
      decoding="async"
    />
  </div>
  <p class="stage mono" id="sk-stage" aria-live="polite">{S.steps[0]}</p>
  <div class="build-progress" aria-hidden="true"><span id="sk-progress"></span></div>
  <figcaption id="sk-cap" class="mono">{S.cap}</figcaption>
  <div class="btns">
    <button type="button" id="sk-btn" class="sbtn">{S.add}</button>
  </div>
  <p class="sr" id="sk-live" aria-live="polite"></p>
</figure>

<style>
.sk {
  --reveal: 25%;
  margin: 44px 0 0;
  border-top: 1px solid var(--line);
  padding-top: 24px;
  display: grid;
  gap: 12px;
  width: 100%;
}
.sketch-window {
  width: 100%;
  overflow: hidden;
  border-radius: 3px;
  background: #f8f6ee;
  line-height: 0;
}
.sketch-art {
  display: block;
  width: 100%;
  height: auto;
  clip-path: inset(0 calc(100% - var(--reveal)) 0 0);
  transition: clip-path 620ms cubic-bezier(.22,.72,.2,1);
}
.stage { margin: 0; min-height: 1.6em; }
.build-progress {
  height: 3px;
  width: 100%;
  overflow: hidden;
  background: var(--line);
  border-radius: 10px;
}
.build-progress span {
  display: block;
  width: 25%;
  height: 100%;
  background: var(--acc);
  border-radius: inherit;
  transition: width 420ms ease;
}
.btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
.sbtn {
  font: 600 .9rem var(--body);
  color: var(--ink);
  background: var(--acc);
  border: 1.5px solid var(--ink);
  border-radius: 12px 4px 12px 4px;
  padding: 9px 16px;
  cursor: pointer;
  transition: transform .2s cubic-bezier(.3,1.6,.5,1), background .2s;
}
.sbtn:hover { transform: translateY(-2px) rotate(-1deg); }
.sbtn:focus-visible { outline: 3px solid var(--acc); outline-offset: 4px; }
.sr {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
@media (max-width: 560px) {
  .sk { margin-top: 30px; padding-top: 18px; gap: 10px; }
  .sketch-window { margin-inline: -2px; width: calc(100% + 4px); }
  .sbtn { padding: 9px 13px; }
}
@media (prefers-reduced-motion: reduce) {
  .sketch-art, .build-progress span, .sbtn { transition: none; }
  .sbtn:hover { transform: none; }
}
</style>

<script>
  const fig = document.querySelector<HTMLElement>('.sk');
  if (fig && !fig.dataset.ready) {
    fig.dataset.ready = 'true';
    const button = fig.querySelector<HTMLButtonElement>('#sk-btn');
    const stageEl = fig.querySelector<HTMLElement>('#sk-stage');
    const live = fig.querySelector<HTMLElement>('#sk-live');
    const progress = fig.querySelector<HTMLElement>('#sk-progress');
    const art = fig.querySelector<HTMLImageElement>('#sk-art');
    const steps: string[] = JSON.parse(fig.dataset.steps ?? '[]');
    let stage = 1;
    const render = () => {
      fig.dataset.stage = String(stage);
      fig.style.setProperty('--reveal', `${stage * 25}%`);
      if (stageEl) stageEl.textContent = steps[stage - 1];
      if (live) live.textContent = steps[stage - 1];
      if (progress) progress.style.width = `${stage * 25}%`;
      if (button) button.textContent = stage === 4 ? fig.dataset.again! : fig.dataset.add!;
      if (art) art.setAttribute('aria-label', steps[stage - 1]);
    };
    button?.addEventListener('click', () => {
      stage = stage === 4 ? 1 : stage + 1;
      render();
    });
    render();
  }
</script>
