---
import c from '../../data/contact.json';
import { langOf, useT } from '../../i18n';
const T = useT(langOf(Astro)).contact;
---
<section id="contact" class="contact" aria-labelledby="contact-h">
  <div class="cols">
    <h2 id="contact-h" class="mono">{T.h}</h2>
    <div>
      <a class="mail link" href={`mailto:${c.email}`}>{c.email}</a>
      <ul class="mono">{c.links.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</section>
<style>
.contact{padding:88px 0 0}.cols{display:grid;grid-template-columns:170px minmax(0,1fr);gap:clamp(16px,4vw,48px)}
h2{font-weight:400;margin:0}.mail{font:500 clamp(1.3rem,3vw,2rem) var(--head);letter-spacing:-.01em;word-break:break-all}
ul{list-style:none;margin:28px 0 0;padding:0;display:flex;gap:10px 28px;flex-wrap:wrap}
@media (max-width:760px){.cols{grid-template-columns:1fr}}
</style>
