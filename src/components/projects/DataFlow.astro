---
// What moves through the system, step by step. Wide: a row with hand-drawn connectors that draw themselves
// when scrolled into view. Narrow: the same steps stacked, no sideways scrolling.
import { langOf, useT } from '../../i18n';
const T = useT(langOf(Astro));
const { steps = [] as string[], notes = [] as string[], label = '' } = Astro.props;
const n = steps.length;
---
{n > 1 && <ol class="df" style={`--n:${n}`} aria-label={T.case.flowAria(label)}>
  {steps.map((s: string, i: number) => (
    <li class={i === n - 1 ? 'last' : ''} style={`--i:${i}`}>
      <span class="mk" aria-hidden="true"></span>
      {i < n - 1 && <svg class="ed" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d={i % 2 ? 'M0 7 C50 13 110 1 200 7' : 'M0 7 C50 1 110 13 200 7'}/></svg>}
      <b>{s}</b>
      {notes[i] && <span class="nt">{notes[i]}</span>}
    </li>
  ))}
</ol>}
<style>
.df{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:0 18px}
.df li{position:relative;padding-top:30px;display:flex;flex-direction:column;gap:4px}
.mk{position:absolute;left:0;top:6px;width:14px;height:14px;border-radius:50%;border:1.5px solid var(--ink);background:var(--bg);z-index:1}
.last .mk{background:var(--acc)}
.ed{position:absolute;left:18px;top:6px;width:calc(100% - 4px);height:14px;overflow:visible}
.df li:not(.last)::after{content:"";position:absolute;left:calc(100% + 8px);top:9px;border:4px solid transparent;border-left:7px solid var(--ink);border-right:0}
.ed path{fill:none;stroke:var(--ink);stroke-width:1.5;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:0}
.df b{font:600 1rem var(--head);color:var(--ink)}
.nt{font:400 .8125rem/1.5 var(--mono);color:var(--ink2);max-width:30ch}
/* draw-in: only when the page script is active */
.js .df:not(.in) .ed path{stroke-dashoffset:1}
.js .df:not(.in) .mk{transform:scale(.6);opacity:.4}
.df.in .ed path{transition:stroke-dashoffset .6s ease calc(var(--i) * .22s + .1s)}
.df.in .mk{transition:transform .35s cubic-bezier(.3,1.6,.5,1) calc(var(--i) * .22s),opacity .3s calc(var(--i) * .22s)}
@media (max-width:820px){
  .df{grid-template-columns:1fr;gap:0}
  .df li{padding:0 0 22px 32px;min-height:34px}
  .mk{top:3px}
  .ed,.df li:not(.last)::after{display:none}
  .df li:not(.last)::before{content:"";position:absolute;left:6.5px;top:22px;bottom:-1px;border-left:1.5px solid var(--ink)}
  .nt{max-width:none}
}
@media (prefers-reduced-motion:reduce){.js .df:not(.in) .ed path{stroke-dashoffset:0}.js .df:not(.in) .mk{transform:none;opacity:1}}
</style>
