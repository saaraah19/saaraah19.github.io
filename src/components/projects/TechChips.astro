---
// Technologies, small but unmissable: outlined chips with a warm tint.
import { langOf, useT } from '../../i18n';
const { items = [], label = useT(langOf(Astro)).tech.builtWith } = Astro.props;
---
{items.length > 0 && <div class="tc"><span class="mono up">{label}</span><ul>{items.map((t: string) => <li>{t}</li>)}</ul></div>}
<style>
.tc{margin-top:22px}
ul{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
li{font:500 .8125rem var(--body);color:var(--ink);border:1px solid var(--ink);border-radius:4px;padding:2px 10px;background:color-mix(in srgb,var(--acc) 20%,var(--bg))}
</style>
