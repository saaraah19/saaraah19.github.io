---
// Sticker buttons. Each one has a small cat that peeks over its top edge on hover or keyboard focus.
import { langOf, useT } from '../../i18n';
const L = useT(langOf(Astro)).links;
const { live, github, story } = Astro.props;
---
<div class="acts">
  {story && <span class="sb"><a class="sbtn pri" href={story}>{L.story} <span aria-hidden="true">→</span></a><span class="peek" aria-hidden="true"><svg viewBox="0 0 46 30" width="46" height="30"><g stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19 L7 4 L20 11 Z" style="fill:var(--bg)"/><path d="M37 19 L39 4 L26 11 Z" style="fill:var(--bg)"/><path d="M10.2 13.5 L9.4 8 L14.6 11 Z" stroke="none" style="fill:var(--cheek)"/><path d="M35.8 13.5 L36.6 8 L31.4 11 Z" stroke="none" style="fill:var(--cheek)"/><ellipse cx="23" cy="26" rx="17" ry="13" style="fill:var(--bg)"/><circle cx="17" cy="21" r="2.1" stroke="none" style="fill:var(--ink)"/><circle cx="29" cy="21" r="2.1" stroke="none" style="fill:var(--ink)"/><ellipse cx="10.5" cy="25" rx="3.2" ry="2" stroke="none" opacity=".85" style="fill:var(--cheek)"/><ellipse cx="35.5" cy="25" rx="3.2" ry="2" stroke="none" opacity=".85" style="fill:var(--cheek)"/><path d="M23 23.8 q-1.8 2.4 -3.8 .7 M23 23.8 q1.8 2.4 3.8 .7" fill="none" stroke-width="1.2"/><ellipse cx="13" cy="29.4" rx="4.2" ry="2.6" style="fill:var(--bg)"/><ellipse cx="33" cy="29.4" rx="4.2" ry="2.6" style="fill:var(--bg)"/></g></svg></span></span>}
  {live && <span class="sb"><a class="sbtn" href={live} data-warm="1"><i class="dot"></i>{L.live} <span aria-hidden="true">↗</span></a><span class="peek" aria-hidden="true"><svg viewBox="0 0 46 30" width="46" height="30"><g stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19 L7 4 L20 11 Z" style="fill:var(--bg)"/><path d="M37 19 L39 4 L26 11 Z" style="fill:var(--bg)"/><path d="M10.2 13.5 L9.4 8 L14.6 11 Z" stroke="none" style="fill:var(--cheek)"/><path d="M35.8 13.5 L36.6 8 L31.4 11 Z" stroke="none" style="fill:var(--cheek)"/><ellipse cx="23" cy="26" rx="17" ry="13" style="fill:var(--bg)"/><circle cx="17" cy="21" r="2.1" stroke="none" style="fill:var(--ink)"/><circle cx="29" cy="21" r="2.1" stroke="none" style="fill:var(--ink)"/><ellipse cx="10.5" cy="25" rx="3.2" ry="2" stroke="none" opacity=".85" style="fill:var(--cheek)"/><ellipse cx="35.5" cy="25" rx="3.2" ry="2" stroke="none" opacity=".85" style="fill:var(--cheek)"/><path d="M23 23.8 q-1.8 2.4 -3.8 .7 M23 23.8 q1.8 2.4 3.8 .7" fill="none" stroke-width="1.2"/><ellipse cx="13" cy="29.4" rx="4.2" ry="2.6" style="fill:var(--bg)"/><ellipse cx="33" cy="29.4" rx="4.2" ry="2.6" style="fill:var(--bg)"/></g></svg></span></span>}
  {github && <span class="sb"><a class="sbtn" href={github}>{L.github} <span aria-hidden="true">↗</span></a><span class="peek" aria-hidden="true"><svg viewBox="0 0 46 30" width="46" height="30"><g stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19 L7 4 L20 11 Z" style="fill:var(--bg)"/><path d="M37 19 L39 4 L26 11 Z" style="fill:var(--bg)"/><path d="M10.2 13.5 L9.4 8 L14.6 11 Z" stroke="none" style="fill:var(--cheek)"/><path d="M35.8 13.5 L36.6 8 L31.4 11 Z" stroke="none" style="fill:var(--cheek)"/><ellipse cx="23" cy="26" rx="17" ry="13" style="fill:var(--bg)"/><circle cx="17" cy="21" r="2.1" stroke="none" style="fill:var(--ink)"/><circle cx="29" cy="21" r="2.1" stroke="none" style="fill:var(--ink)"/><ellipse cx="10.5" cy="25" rx="3.2" ry="2" stroke="none" opacity=".85" style="fill:var(--cheek)"/><ellipse cx="35.5" cy="25" rx="3.2" ry="2" stroke="none" opacity=".85" style="fill:var(--cheek)"/><path d="M23 23.8 q-1.8 2.4 -3.8 .7 M23 23.8 q1.8 2.4 3.8 .7" fill="none" stroke-width="1.2"/><ellipse cx="13" cy="29.4" rx="4.2" ry="2.6" style="fill:var(--bg)"/><ellipse cx="33" cy="29.4" rx="4.2" ry="2.6" style="fill:var(--bg)"/></g></svg></span></span>}
</div>
<style>
.acts{display:flex;gap:14px 14px;flex-wrap:wrap;align-items:flex-start;align-self:start;padding-top:30px}
.sb{position:relative;display:inline-block}
.sbtn{display:inline-flex;align-items:center;gap:8px;font:600 .9375rem var(--body);text-decoration:none;color:var(--ink);background:var(--bg);border:1.5px solid var(--ink);border-radius:14px 5px 14px 5px;padding:9px 18px;transition:transform .2s cubic-bezier(.3,1.6,.5,1),background .2s}
.sbtn:hover{background:var(--acc);color:var(--acc-ink);transform:rotate(-1.2deg) translateY(-2px)}
.sbtn.pri{background:var(--acc);color:var(--acc-ink)}
.sbtn.pri:hover{transform:rotate(1.2deg) translateY(-2px)}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--live);box-shadow:0 0 0 3px color-mix(in srgb,var(--live) 25%,transparent)}
.sbtn:hover .dot{background:var(--ink);box-shadow:0 0 0 3px color-mix(in srgb,var(--ink) 20%,transparent)}
.peek{position:absolute;left:50%;margin-left:-23px;bottom:calc(100% - 2px);width:46px;height:30px;overflow:hidden;pointer-events:none;z-index:2}
.sb:nth-child(2) .peek{left:64%}.sb:nth-child(3) .peek{left:40%}
.peek svg{display:block;transform:translateY(100%);transition:transform .32s cubic-bezier(.3,1.7,.5,1)}
.sb:hover .peek svg,.sb:focus-within .peek svg{transform:translateY(0)}
</style>
