---
import { Image } from 'astro:assets';
// A real screenshot in a hairline frame. Wide images show whole; near-square or tall
// ones are cropped to the top (a link opens the full image); phone-shaped ones sit at natural size.
import { langOf, useT } from '../../i18n';
const T = useT(langOf(Astro));
const { shot, lead = false, sizes = '(max-width: 820px) 100vw, 560px', eager = false, label = '' } = Astro.props;
const { width, height } = shot.src;
const r = width / height;
const kind = r < 0.85 ? 'portrait' : r < 1.45 ? 'crop' : 'wide';
---
<figure class={`shot ${kind}${lead ? ' lead' : ''}`}>
  {label && <p class="rl mono">{label}</p>}
  <a class="frame" href={shot.src.src} target="_blank" rel="noopener" aria-label={`${T.shot.open}${shot.caption}`}>
    <Image src={shot.src} alt={shot.alt} widths={[480, 800, 1200, 1800]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </a>
  <figcaption class="mono">{shot.caption}</figcaption>
</figure>
<style>
.shot{margin:0}
.rl{margin:0 0 6px;text-transform:uppercase;letter-spacing:.09em;font-size:.6875rem;color:var(--ink)}
.frame{display:block;border:1px solid var(--line);background:var(--bg);line-height:0;overflow:hidden}
.frame:hover{border-color:var(--ink)}
.frame img{display:block;width:100%;height:auto}
.crop .frame{aspect-ratio:1.45}.crop img{height:100%;object-fit:cover;object-position:top}
.portrait .frame{width:fit-content;max-width:100%;margin:0 auto}
.portrait img{width:auto;max-width:100%;max-height:520px}
.lead.portrait .frame{margin:0}
figcaption{margin-top:8px;max-width:60ch}
</style>
