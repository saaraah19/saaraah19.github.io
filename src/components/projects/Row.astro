---
import { Image } from 'astro:assets';
import StatusTag from './StatusTag.astro';
import Links from './Links.astro';
import TechChips from './TechChips.astro';
import LiveNotice from './LiveNotice.astro';
import CatFigure from '../cats/CatFigure.astro';
import { langOf, useT, href } from '../../i18n';
const lang = langOf(Astro);
const { p } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const story = href(lang, `/work/${p.id}`);
const thumb = p.shots?.[p.leadShot ?? 0];
const poster = !thumb && p.video ? `${b}/media/${p.id}/demo.webp` : null;
---
<li id={p.id} class={thumb || poster ? 'has-t' : ''}>
  {(thumb || poster) && <a class="thumb" href={story} tabindex="-1" aria-hidden="true">
    {thumb ? <Image src={thumb.src} alt="" widths={[240, 480]} sizes="200px" loading="lazy" /> : <img src={poster} alt="" loading="lazy" width="480" height="300" />}
  </a>}
  <div class="t">
    <h3>{p.title} <StatusTag status={p.status} href={p.live} title={p.title} />{p.cat && <button class="catbtn" type="button" aria-label={useT(lang).catDance}><svg viewBox="0 0 120 124" width="52" height="54" aria-hidden="true"><CatFigure variant={p.cat} /></svg></button>}</h3>
    {p.problem && <p class="pr">{p.problem}</p>}
    <p>{p.built ?? p.summary}</p>
    <LiveNotice url={p.live} wake={p.wake} compact />
    <TechChips items={p.technologies} />
    <Links live={p.live} github={p.github} story={story} />
  </div>
</li>
<style>
li{display:grid;grid-template-columns:minmax(0,1fr);gap:8px 28px;padding:30px 0;border-top:1px solid var(--line);list-style:none}
li.has-t{grid-template-columns:200px minmax(0,1fr);align-items:start}
.thumb{display:block;border:1px solid var(--line);aspect-ratio:1.5;overflow:hidden;line-height:0}
.thumb:hover{border-color:var(--ink)}
.thumb img{width:100%;height:100%;object-fit:cover;object-position:top}
h3{font-size:1.35rem;display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:4px}
p{margin:0;max-width:62ch;color:var(--ink2)}.pr{color:var(--ink);margin-bottom:4px}
@media (max-width:760px){li,li.has-t{grid-template-columns:1fr}.thumb{max-width:320px}}
.catbtn{border:0;background:none;padding:0;line-height:0;color:var(--ink);cursor:pointer}.catbtn svg{transform-origin:50% 100%}
.catbtn.dance svg{animation:bob .45s ease-in-out 5}
@keyframes bob{50%{transform:translateY(-5px) rotate(-6deg)}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('.catbtn').forEach((b) => b.addEventListener('click', () => { b.classList.remove('dance'); void b.offsetWidth; b.classList.add('dance'); setTimeout(() => b.classList.remove('dance'), 2400); }));
</script>
