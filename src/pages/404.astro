---
import Base from '../layouts/Base.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
// A static host serves one 404 page, so this one speaks both languages.
---
<Base title="404 · Sarra Sawsene Sahraoui" noAlt>
  <div class="wrap" style="padding-top:80px;padding-bottom:40px">
    <p class="mono">404</p>
    <h1 style="font-size:clamp(1.75rem,4vw,2.6rem)">We seem to have lost this point.</h1>
    <p lang="fr" style="font-size:1.1rem;color:var(--ink2);margin:.4em 0 0">On dirait qu’on a perdu ce point.</p>
    <p class="mono" style="margin:1.2em 0 1.6em">x = ?<br />y = ?</p>
    <a class="btn" href={`${b}/`}>GO HOME</a>
    <a class="btn" lang="fr" href={`${b}/fr/`} style="margin-left:10px">RETOUR À L’ACCUEIL</a>
  </div>
</Base>
